# Configuração PIX - Firmeza Token
# Copie este arquivo para .env.local na raiz do projeto e configure seus dados reais

# CONFIGURAÇÃO DA API FIRMEZA
# =========================
NEXT_PUBLIC_FIRMEZA_API_URL=http://localhost:3000/api

# DADOS PIX - CONFIGURE AQUI SEUS DADOS REAIS
# ===========================================

# Sua chave PIX real (CPF, CNPJ, email, telefone ou chave aleatória)
# Exemplos:
# CPF: 12345678901 (apenas números)
# CNPJ: 12345678000195 (apenas números)  
# Email: contato@empresa.com
# Telefone: +5511999999999 (formato internacional)
# Chave aleatória: 12345678-1234-1234-1234-123456789012
NEXT_PUBLIC_PIX_KEY=

# Nome que aparecerá no PIX (máximo 25 caracteres)
NEXT_PUBLIC_PIX_MERCHANT_NAME=Firmeza Tecnologia Ltda

# Cidade que aparecerá no PIX (máximo 15 caracteres, MAIÚSCULAS)
NEXT_PUBLIC_PIX_MERCHANT_CITY=SAO PAULO

# CONFIGURAÇÕES DE EMAIL - EMAILJS
# =================================

# EmailJS Service ID (obrigatório)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=seu_service_id

# EmailJS Public Key (obrigatório)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=sua_public_key

# Template para solicitações de tokens (obrigatório)
NEXT_PUBLIC_EMAILJS_TEMPLATE_TOKEN_ID=template_token_id

# Template para faturas (opcional)
NEXT_PUBLIC_EMAILJS_TEMPLATE_INVOICE_ID=template_invoice_id

# Template para comprovantes PIX (IMPORTANTE!)
# ============================================
# Se não configurado, o sistema usará o template de tokens como fallback
# Isso significa que os parâmetros total_amount, receipt_url e pix_transaction_id
# NÃO serão enviados ao template
NEXT_PUBLIC_EMAILJS_TEMPLATE_PIX_RECEIPT_ID=template_pix_receipt_id

# INSTRUÇÕES:
# ===========
# 1. Copie este arquivo para .env.local na raiz do projeto
# 2. Substitua os valores pelos seus dados reais
# 3. Reinicie o servidor de desenvolvimento
# 4. NUNCA commite o arquivo .env.local no Git!

# IMPORTANTE:
# - Use apenas números para CPF/CNPJ (sem pontos, hífens ou barras)
# - Nome do comerciante não pode exceder 25 caracteres
# - Cidade não pode exceder 15 caracteres e deve estar em MAIÚSCULAS
# - Para telefone, use o formato internacional (+5511999999999)

# PARÂMETROS DO TEMPLATE PIX (templatePixReceipt):
# ===============================================
# {{token_amount}} - Quantidade de tokens
# {{total_amount}} - Valor total com taxa (R$ XX,XX)
# {{username}} - Nome do usuário
# {{property_id}} - ID da propriedade
# {{purchase_date}} - Data da compra (DD/MM/AAAA)
# {{purchase_time}} - Hora da compra (HH:MM:SS)
# {{receipt_url}} - URL do comprovante no IPFS
# {{pix_transaction_id}} - ID da transação PIX
# {{subject}} - Assunto do email 